<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BrazilOmu.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Bg}">
    <ScrollView>
        <VerticalStackLayout Padding="22,60,22,30" Spacing="18">

            <Border BackgroundColor="{StaticResource PurpleDark}" StrokeThickness="0"
                    WidthRequest="84" HeightRequest="84" HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 24">
                <Label Text="B" TextColor="White" FontSize="44" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                <Label Text="BRAZIL" TextColor="White" FontSize="30" FontAttributes="Bold" CharacterSpacing="2" />
                <Label Text="OMU" TextColor="{StaticResource Purple}" FontSize="30" FontAttributes="Bold" CharacterSpacing="2" />
            </HorizontalStackLayout>
            <Label Text="CONTROL PANEL • MOBILE EDITION" TextColor="{StaticResource Muted}"
                   FontSize="12" HorizontalOptions="Center" CharacterSpacing="1" />

            <Border BackgroundColor="{StaticResource Card}" Stroke="{StaticResource Line}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20" Padding="20" Margin="0,18,0,0">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Panel access" TextColor="White" FontSize="22" FontAttributes="Bold" />
                    <Label Text="Enter your access key to continue." TextColor="{StaticResource Muted}" FontSize="14" />
                    <Label Text="ACCESS KEY" TextColor="White" FontSize="12" Margin="0,8,0,0" />
                    <Border BackgroundColor="#050412" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 12" Padding="12,0">
                        <Entry x:Name="KeyEntry" Placeholder="Enter your key..." TextColor="White"
                               PlaceholderColor="#6c6489" Keyboard="Text" />
                    </Border>
                    <Label x:Name="ErrorLabel" TextColor="#FF5C7A" FontSize="13" IsVisible="False" />
                    <Button x:Name="EnterButton" Text="ENTER PANEL" Clicked="OnEnterClicked"
                            BackgroundColor="{StaticResource Purple}" TextColor="White"
                            FontAttributes="Bold" CornerRadius="12" HeightRequest="50" />
                    <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" Color="{StaticResource Purple}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="BRAZIL OMU © 2026" TextColor="{StaticResource Muted}" FontSize="11" HorizontalOptions="Center" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
