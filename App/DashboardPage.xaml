<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BrazilOmu.DashboardPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Bg}">
    <ScrollView>
        <VerticalStackLayout Padding="20,50,20,30" Spacing="16">

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                <Label Text="BRAZIL" TextColor="White" FontSize="28" FontAttributes="Bold" CharacterSpacing="2" />
                <Label Text="OMU" TextColor="{StaticResource Purple}" FontSize="28" FontAttributes="Bold" CharacterSpacing="2" />
            </HorizontalStackLayout>
            <Label Text="CONTROL PANEL • MOBILE EDITION" TextColor="{StaticResource Muted}" FontSize="12" HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                <VerticalStackLayout>
                    <Label Text="Dashboard" TextColor="White" FontSize="26" FontAttributes="Bold" />
                    <Label x:Name="WelcomeLabel" Text="Welcome to Brazil Omu" TextColor="{StaticResource Muted}" FontSize="13" />
                    <Label x:Name="ExpiryLabel" TextColor="{StaticResource Muted}" FontSize="12" />
                </VerticalStackLayout>
                <Border Grid.Column="1" x:Name="StatusBadge" BackgroundColor="#12351f" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" Padding="12,6" VerticalOptions="Start">
                    <Label x:Name="StatusLabel" Text="● CHECKING" TextColor="#2ECC71" FontSize="12" FontAttributes="Bold" />
                </Border>
            </Grid>

            <Border BackgroundColor="{StaticResource Card}" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 20" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="AVAILABLE SETTINGS" TextColor="{StaticResource Muted}" FontSize="12" CharacterSpacing="2" Margin="0,4,0,6" />

                    <Border BackgroundColor="#140f2c" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="NOTIFICATIONS" TextColor="White" FontAttributes="Bold" />
                                <Label Text="Receive alerts and updates" TextColor="{StaticResource Muted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" x:Name="SwNotif" OnColor="{StaticResource Purple}" Toggled="OnToggled" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#140f2c" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="HAPTIC FEEDBACK" TextColor="White" FontAttributes="Bold" />
                                <Label Text="Vibrate on button taps" TextColor="{StaticResource Muted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" x:Name="SwHaptic" OnColor="{StaticResource Purple}" Toggled="OnToggled" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#140f2c" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="AUTO SYNC" TextColor="White" FontAttributes="Bold" />
                                <Label Text="Keep your data up to date" TextColor="{StaticResource Muted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" x:Name="SwSync" OnColor="{StaticResource Purple}" Toggled="OnToggled" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#140f2c" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="DATA SAVER" TextColor="White" FontAttributes="Bold" />
                                <Label Text="Use less mobile data" TextColor="{StaticResource Muted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" x:Name="SwSaver" OnColor="{StaticResource Purple}" Toggled="OnToggled" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#140f2c" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="SOUND EFFECTS" TextColor="White" FontAttributes="Bold" />
                                <Label Text="Play sounds in the app" TextColor="{StaticResource Muted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" x:Name="SwSound" OnColor="{StaticResource Purple}" Toggled="OnToggled" />
                        </Grid>
                    </Border>

                    <Button Text="⚡ APPLY SETTINGS" Clicked="OnApplyClicked" BackgroundColor="{StaticResource Purple}"
                            TextColor="White" FontAttributes="Bold" CornerRadius="14" HeightRequest="54" Margin="0,12,0,0" />

                    <Border BackgroundColor="#020a05" Stroke="#10301a" StrokeShape="RoundRectangle 14" Padding="14" Margin="0,8,0,0">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="ACTIVITY LOG" TextColor="#9be8b0" FontFamily="Courier" FontSize="12" />
                            <Label x:Name="LogLabel" TextColor="#4DFF88" FontFamily="Courier" FontSize="12" Text="&gt; Waiting for action..." />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Button Text="SIGN OUT" Clicked="OnSignOutClicked" BackgroundColor="Transparent" TextColor="#d9b8ff"
                    BorderColor="{StaticResource Line}" BorderWidth="1" CornerRadius="14" HeightRequest="46" />

            <Label Text="BRAZIL OMU © 2026" TextColor="{StaticResource Muted}" FontSize="11" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
